# Flask API origin. Set this to the deployed Flask API URL in production.
GITSCOPE_API_BASE_URL=http://127.0.0.1:5000

# PostgreSQL connection string used only by the Next.js server and Prisma.
DATABASE_URL=postgresql://gitscope:change-me@localhost:5432/gitscope?schema=public

# Auth0 Regular Web Application settings. Never expose these as NEXT_PUBLIC_*.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
# Generate with: openssl rand -hex 32
AUTH0_SECRET=replace-with-32-byte-hex-secret
# Must exactly match the `iss` claim from the Auth0 ID token.
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
APP_BASE_URL=http://localhost:3000

# Public site origin, used for canonical URLs and sitemap output. Set before
# building the frontend so generated metadata and sitemap use the deployed URL.
# Set this to the deployed frontend origin in production.
GITSCOPE_SITE_URL=
