# Local-only Compose defaults. Copy to .env to customize; never put real
# production credentials in this file.
# Production uses compose.production.yaml with explicit required settings.
POSTGRES_DB=gitscope
POSTGRES_USER=gitscope
POSTGRES_PASSWORD=local-dev-only

FRONTEND_PORT=3000
BACKEND_PORT=5000
GITSCOPE_SITE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Optional integrations for local development.
GITHUB_TOKEN=
GITSCOPE_CORS_ORIGINS=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_ISSUER=
