# GitScope Environment Variables Example
# Copy this file to backend/.env and replace with your actual values.
# DO NOT commit backend/.env to source control!

# Server-side GitHub token. Phase 5 does not enable per-user/private access.
# Prefer a credential limited to public-data reads; never expose it to clients.
GITHUB_TOKEN=your_github_personal_access_token_here

# Allowed browser origins for direct public API use. Next.js server-to-server
# requests do not use CORS. Use an empty value if no browser client needs access.
GITSCOPE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
