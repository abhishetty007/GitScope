# GitScope Environment Variables Example
# Copy this file to backend/.env and replace with your actual values.
# DO NOT commit backend/.env to source control!

# Server-side GitHub token. Phase 5 does not enable per-user/private access.
# Prefer a credential limited to public-data reads; never expose it to clients.
GITHUB_TOKEN=ghp_replace_with_a_public_read_only_token

# Local Compose supplies the limiter URL automatically. For direct backend
# development, point this to a local PostgreSQL instance after migrations.
GITSCOPE_RATE_LIMIT_DATABASE_URL=postgresql://gitscope:local-dev-only@127.0.0.1:5432/gitscope?sslmode=disable
GITSCOPE_GITHUB_UPSTREAM_BUDGET_PER_HOUR=2000

# Local development only: browser origins for direct API use.
# Production GitScope uses Next.js server-to-server calls; keep this empty.
GITSCOPE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
